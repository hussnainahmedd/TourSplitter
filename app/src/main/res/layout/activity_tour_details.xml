<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center"
    android:background="#F5F5F5">

    <!-- Tour Info Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        app:cardElevation="4dp"
        app:cardCornerRadius="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@android:drawable/ic_menu_compass"
                android:layout_marginEnd="16dp"
                app:tint="#2196F3" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTourInfoLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tour Management"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#424242"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Manage all tour activities"
                    android:textSize="14sp"
                    android:textColor="#757575"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Manage Members Button -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardElevation="4dp"
        app:cardCornerRadius="8dp">

        <Button
            android:id="@+id/btnManageMembers"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="Manage Members"
            android:textSize="16sp"
            android:textAllCaps="false"
            android:drawableLeft="@android:drawable/ic_menu_my_calendar"
            android:drawablePadding="12dp"
            android:gravity="start|center_vertical"
            android:paddingStart="16dp"
            android:backgroundTint="#FFFFFF"
            android:textColor="#424242"
            style="?attr/materialButtonOutlinedStyle"/>
    </com.google.android.material.card.MaterialCardView>

    <!-- Add Expense Button -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardElevation="4dp"
        app:cardCornerRadius="8dp">

        <Button
            android:id="@+id/btnAddExpense"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="Add Expense"
            android:textSize="16sp"
            android:textAllCaps="false"
            android:drawableLeft="@android:drawable/ic_input_add"
            android:drawablePadding="12dp"
            android:gravity="start|center_vertical"
            android:paddingStart="16dp"
            android:backgroundTint="#FFFFFF"
            android:textColor="#424242"
            style="?attr/materialButtonOutlinedStyle"/>
    </com.google.android.material.card.MaterialCardView>

    <!-- View Summary Button -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardElevation="4dp"
        app:cardCornerRadius="8dp">

        <Button
            android:id="@+id/btnViewSummary"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="View Summary"
            android:textSize="16sp"
            android:textAllCaps="false"
            android:drawableLeft="@android:drawable/ic_menu_info_details"
            android:drawablePadding="12dp"
            android:gravity="start|center_vertical"
            android:paddingStart="16dp"
            android:backgroundTint="#FFFFFF"
            android:textColor="#424242"
            style="?attr/materialButtonOutlinedStyle"/>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>